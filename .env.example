# ─────────────────────────────────────────────────────────────
# Firebase configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the values from your
# Firebase project settings (Project settings → General → Your apps).
#
# Until these are filled in, the app runs in DEMO MODE with local
# seed data so you can preview the UI. Once filled in, it switches
# to live Firestore + Auth automatically.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=