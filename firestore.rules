rules_version = '2';

// Security model: anyone can READ the schedule (family just opens the site),
// but only a signed-in admin (mom) can WRITE. Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /workers/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /shifts/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Employee of the Month (and any future single-value app metadata).
    match /meta/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
